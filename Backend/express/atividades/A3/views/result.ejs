<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atividades Cadastradas</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            animation: slideIn 0.5s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h1 {
            color: white;
            text-align: center;
            margin-bottom: 40px;
            font-size: 32px;
        }

        .table-wrapper {
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        th {
            padding: 18px 20px;
            text-align: left;
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        td {
            padding: 16px 20px;
            border-bottom: 1px solid #f0f0f0;
            color: #333;
            font-size: 14px;
        }

        tbody tr {
            transition: all 0.3s ease;
        }

        tbody tr:hover {
            background-color: #f8f9fa;
            transform: scale(1.01);
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.1) inset;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
            margin-top: 30px;
            justify-content: center;
            padding: 0 20px 20px;
        }

        button {
            padding: 12px 25px;
            font-size: 14px;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-back {
            background-color: #e0e0e0;
            color: #333;
        }

        .btn-back:hover {
            background-color: #d0d0d0;
            transform: translateX(-5px);
        }

        .btn-print {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-print:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: white;
        }

        .empty-state h2 {
            font-size: 24px;
            margin-bottom: 10px;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 24px;
            }

            th, td {
                padding: 12px 10px;
                font-size: 12px;
            }

            .table-wrapper {
                overflow-x: auto;
            }

            table {
                min-width: 600px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>✓ Atividades Cadastradas</h1>
        
        <% if (Atividade && Atividade.length > 0) { %>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Nome da Atividade</th>
                            <th>Descrição</th>
                            <th>Data de Início</th>
                            <th>Data de Fim</th>
                            <th>Hora de Início</th>
                            <th>Hora de Fim</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% Atividade.forEach((ativ) => { %>
                            <tr>
                                <td><strong><%= ativ.Atvname %></strong></td>
                                <td><%= ativ.Atvdesc %></td>
                                <td><%= ativ.AtvdateInit %></td>
                                <td><%= ativ.AtvdateEnd %></td>
                                <td><%= ativ.Atvtimeinit %></td>
                                <td><%= ativ.Atvtimend %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            
            <div class="action-buttons">
                <button class="btn-back" onclick="history.back()">← Voltar</button>
                <button class="btn-print" onclick="window.print()">🖨️ Imprimir</button>
            </div>
        <% } else { %>
            <div class="empty-state">
                <h2>📭 Nenhuma atividade cadastrada</h2>
                <p>Clique no botão abaixo para adicionar uma nova atividade</p>
                <button class="btn-back" onclick="history.back()" style="margin-top: 20px; background: white; color: #333;">Adicionar Atividade</button>
            </div>
        <% } %>
    </div>
</body>
</html>