<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <table>
        <tr>
            <th>Nome do Jogador</th>
            <th>Numero de Gols</th>
        </tr>
        <% Jogador.forEach(jogador => { %>
        <tr>
            <td><%= jogador.name %></td>
            <td><%= jogador.gols %></td>
        </tr>
        <% }); %>
    </table>
    <a href="/">Adicionar mais jogadores</a>
</body>
</html>